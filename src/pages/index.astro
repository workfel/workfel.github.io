---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import AppBand from '../components/AppBand.astro';
import Footer from '../components/Footer.astro';
import { apps, stats } from '../data/apps';

const workCount = String(stats.appsCount).padStart(2, '0');
---

<Layout title="Johan Pujol — Indie Software">
  <div class="cursor" id="cursor"></div>
  <div class="dot-cursor" id="cursorDot"></div>

  <TopBar />

  <main class="wrap" id="top">
    <Hero />

    <section id="work">
      <div class="work-head reveal">
        <span class="mono k">Selected work</span>
        <div class="work-head-tools">
          <span class="mono work-count">Shipped &amp; in the wild — {workCount}</span>
          <div class="view-switch" role="group" aria-label="Work layout density">
            <button class="vbtn" type="button" data-view-set="list" aria-label="Editorial list view" aria-pressed="false" data-interactive>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
                ><path d="M4 6h16M4 12h16M4 18h16"></path></svg
              >
            </button>
            <button class="vbtn" type="button" data-view-set="grid" aria-label="Compact grid view" aria-pressed="false" data-interactive>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><rect x="3" y="3" width="8" height="8" rx="1"></rect><rect x="13" y="3" width="8" height="8" rx="1"></rect><rect
                  x="3"
                  y="13"
                  width="8"
                  height="8"
                  rx="1"></rect><rect x="13" y="13" width="8" height="8" rx="1"></rect></svg
              >
            </button>
          </div>
        </div>
      </div>

      {apps.map((app, i) => <AppBand app={app} index={i + 1} />)}
    </section>

    <Footer />
  </main>
</Layout>

<script>
  (function () {
    const root = document.documentElement;

    /* ---------- theme toggle ---------- */
    const toggle = document.getElementById('themeToggle');
    if (toggle) {
      toggle.addEventListener('click', function () {
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('jp-theme', next);
        } catch (e) {}
      });
    }

    /* ---------- work layout density (list ⇄ grid) ---------- */
    const viewBtns = Array.prototype.slice.call(document.querySelectorAll('[data-view-set]'));
    function reflectView(view: string) {
      viewBtns.forEach(function (b) {
        b.setAttribute('aria-pressed', b.getAttribute('data-view-set') === view ? 'true' : 'false');
      });
    }
    function applyView(v: string) {
      const view = v === 'grid' ? 'grid' : 'list';
      root.setAttribute('data-view', view);
      reflectView(view);
      try {
        localStorage.setItem('jp-view', view); // an explicit click sticks across devices
      } catch (e) {}
    }
    /* sync the buttons with the pre-paint default WITHOUT persisting it,
       so the device-based default keeps adapting until the visitor picks one */
    reflectView(root.getAttribute('data-view') === 'grid' ? 'grid' : 'list');
    viewBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        applyView(b.getAttribute('data-view-set') || 'list');
      });
    });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(hover: none), (pointer: coarse)').matches;

    /* ---------- frosted top bar once scrolled off the hero ---------- */
    const topbar = document.querySelector('.topbar');
    if (topbar) {
      let ticking = false;
      const syncBar = function () {
        topbar.classList.toggle('scrolled', window.scrollY > 24);
        ticking = false;
      };
      syncBar();
      window.addEventListener(
        'scroll',
        function () {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(syncBar);
          }
        },
        { passive: true }
      );
    }

    /* ---------- custom cursor ---------- */
    if (!coarse) {
      const ring = document.getElementById('cursor');
      const dot = document.getElementById('cursorDot');
      if (ring && dot) {
        let mx = window.innerWidth / 2;
        let my = window.innerHeight / 2;
        let rx = mx;
        let ry = my;
        let shown = false;
        document.addEventListener('mousemove', function (e) {
          mx = e.clientX;
          my = e.clientY;
          dot.style.left = mx + 'px';
          dot.style.top = my + 'px';
          if (!shown) {
            shown = true;
            ring.classList.add('show');
            dot.classList.add('show');
          }
        });
        document.addEventListener('mouseleave', function () {
          ring.classList.remove('show');
          dot.classList.remove('show');
          shown = false;
        });
        const loop = function () {
          rx += (mx - rx) * 0.16;
          ry += (my - ry) * 0.16;
          ring.style.left = rx + 'px';
          ring.style.top = ry + 'px';
          requestAnimationFrame(loop);
        };
        loop();
        const hot = document.querySelectorAll('a, [data-interactive], .avatar');
        hot.forEach(function (el) {
          el.addEventListener('mouseenter', function () {
            ring.classList.add('grow');
          });
          el.addEventListener('mouseleave', function () {
            ring.classList.remove('grow');
          });
        });
      }
    }

    /* ---------- scroll reveal (IntersectionObserver — no layout thrash) ---------- */
    const revealEls = Array.prototype.slice.call(document.querySelectorAll('.reveal'));
    function showEl(el: Element) {
      el.classList.add('in');
    }
    if (reduce || !('IntersectionObserver' in window)) {
      revealEls.forEach(showEl);
    } else {
      const io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              showEl(entry.target);
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.01 }
      );
      revealEls.forEach(function (el) {
        io.observe(el);
      });
      /* safety net: never leave content hidden */
      setTimeout(function () {
        revealEls.forEach(showEl);
      }, 2600);
    }
  })();
</script>
