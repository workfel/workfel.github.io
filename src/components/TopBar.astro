---
import { profile } from '../data/profile';

const github = profile.socials.find((s) => s.network === 'GitHub');
const x = profile.socials.find((s) => s.network === 'X');
---

<header class="topbar">
  <a class="brand" href="#top">{profile.brand}</a>
  <nav>
    <a href="#work">Work</a>
    {github && <a href={github.url} target="_blank" rel="noopener">GitHub</a>}
    {x && <a href={x.url} target="_blank" rel="noopener">X</a>}
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle light / dark theme" data-interactive>
      <span class="ic ic-moon">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" fill="currentColor"></path></svg
        >
      </span>
      <span class="ic ic-sun">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
          ><circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path></svg
        >
      </span>
      <span class="knob"></span>
    </button>
  </nav>
</header>
