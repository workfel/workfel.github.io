---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Johan Pujol — indie software. The apps that made it out.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-layout="ledger-b">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* load fonts without blocking the first render (swap to stylesheet once loaded) */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
      />
    </noscript>
    <!-- set theme before paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('jp-theme');
          if (saved === 'light' || saved === 'dark') {
            /* explicit choice (via the toggle) always wins */
            document.documentElement.setAttribute('data-theme', saved);
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            /* no choice yet: follow the OS / browser. The base :root is dark,
               so we only need to opt into light when the system prefers it. */
            document.documentElement.setAttribute('data-theme', 'light');
          }
          var view = localStorage.getItem('jp-view');
          if (view !== 'grid' && view !== 'list') {
            /* no explicit choice yet: grid on desktop, list on mobile.
               Not persisted, so it keeps adapting to the device until the
               visitor actually picks a view. */
            view = window.innerWidth > 900 ? 'grid' : 'list';
          }
          document.documentElement.setAttribute('data-view', view);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
